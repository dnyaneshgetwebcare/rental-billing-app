# Copy to .env (never commit .env). On GoDaddy create ~/billing-api/.env once by hand.
APP_ENV=prod
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Public URL of the site, used in share links (no trailing slash)
APP_URL=https://billing.example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=billing
DB_USER=billing
DB_PASSWORD=

# At least 32 random characters, e.g. output of: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# false only for local http://localhost
COOKIE_SECURE=true

# Google Cloud → APIs & Services → Credentials → OAuth client ID → Web application.
# Authorized JavaScript origin: http://localhost:8082  (and the live https domain).
# The same client ID goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Where uploaded images are stored and the URL they are served from (Apache serves them directly).
# GoDaddy: UPLOAD_DIR=/home/<cpanel-user>/public_html/uploads
UPLOAD_DIR=/var/www/html/uploads
UPLOAD_URL=/uploads
