# Same file locally (Docker Apache) and on GoDaddy shared hosting.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP (stripped by some CGI/FPM setups).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Uncomment on the server once SSL works (Cloudflare "Full (strict)" + AutoSSL):
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # API: everything under /api goes to the Yii3 entry point.
    RewriteCond %{REQUEST_URI} !^/api/index\.php
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # Uploads are served as plain files; missing files are a 404, never the app.
    RewriteRule ^uploads/ - [L]

    # React routes: anything that is not a real file goes to index.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Hashed build files and resized images never change: cache for a year.
    <If "%{REQUEST_URI} =~ m#^/(assets|uploads)/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # The app shell and service worker must always be revalidated so new releases load.
    <If "%{REQUEST_URI} =~ m#^/(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)?$#">
        Header set Cache-Control "no-cache"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
</IfModule>
